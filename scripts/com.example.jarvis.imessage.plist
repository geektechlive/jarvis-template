<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.example.jarvis.imessage</string>

    <key>WatchPaths</key>
    <array>
        <string>/Users/<username>/Library/Messages</string>
    </array>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/<username>/Jarvis/scripts/imessage-watcher.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/<username>/Jarvis</string>

    <key>StandardOutPath</key>
    <string>/Users/<username>/Jarvis/logs/imessage.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/<username>/Jarvis/logs/imessage.error.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <!-- IMESSAGE_WEBHOOK_TOKEN must be set in this dict or inherited from harness plist -->
    </dict>
</dict>
</plist>
