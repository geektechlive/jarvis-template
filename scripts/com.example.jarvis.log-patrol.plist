<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.example.jarvis.log-patrol</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/python3</string>
        <string>/Users/<username>/Jarvis/scripts/log-patrol.py</string>
    </array>

    <key>StartInterval</key>
    <integer>120</integer>

    <key>WorkingDirectory</key>
    <string>/Users/<username>/Jarvis</string>

    <key>StandardOutPath</key>
    <string>/Users/<username>/Jarvis/logs/log-patrol.out.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/<username>/Jarvis/logs/log-patrol.error.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/Users/<username>/bin</string>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>
</dict>
</plist>
