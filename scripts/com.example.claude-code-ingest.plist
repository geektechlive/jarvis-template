<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.example.claude-code-ingest</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/<username>/Source/Jarvis/scripts/claude-code-ingest.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/<username>/Source/Jarvis</string>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>6</integer>
        <key>Minute</key>
        <integer>45</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/<username>/Source/Jarvis/logs/claude-code-ingest.out.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/<username>/Source/Jarvis/logs/claude-code-ingest.error.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>MINI_HOST</key>
        <string><mac-mini-ip>:9876</string>
        <key>MINI_SSH_HOST</key>
        <string>mini</string>
    </dict>
</dict>
</plist>
