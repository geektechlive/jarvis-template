<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.example.claude-code-ingest-mini</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/python3</string>
        <string>/Users/<username>/Jarvis/scripts/claude-code-ingest.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/<username>/Jarvis</string>

    <key>StartInterval</key>
    <integer>7200</integer>

    <key>StandardOutPath</key>
    <string>/Users/<username>/Jarvis/logs/claude-code-ingest-mini.out.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/<username>/Jarvis/logs/claude-code-ingest-mini.error.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>MINI_HOST</key>
        <string>localhost:9876</string>
    </dict>
</dict>
</plist>
