# Ollama (local inference — primary backend)
OLLAMA_HOST=http://localhost:11434

# Agent data directory
AGENT_DATA_DIR=~/.jarvis

# Optional — web search skill
BRAVE_SEARCH_API_KEY=

# Optional — cloud escalation only (leave blank to stay fully local)
ANTHROPIC_API_KEY=

# Optional — ElevenLabs voice backend (leave blank to use macOS say / local TTS)
# Install voice extra first: uv add 'harness[voice]'
ELEVENLABS_API_KEY=

# Optional — Bluesky (for Chief of Communications posting tool)
# Production path: store in macOS Keychain instead of .env:
#   security add-generic-password -s com.example.jarvis -a bluesky-identifier -w 'user.bsky.social'
#   security add-generic-password -s com.example.jarvis -a bluesky-app-password -w '<app-password>'
# Generate the app password at: https://bsky.app/settings/app-passwords
# Dev/CI fallback only -- env vars are checked before Keychain:
BLUESKY_IDENTIFIER=
BLUESKY_APP_PASSWORD=
