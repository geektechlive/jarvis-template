<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.example.ion-relay</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/<username>/bin/ion-relay</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>RELAY_API_KEY</key>
        <string>RELAY_API_KEY_PLACEHOLDER</string>
        <key>RELAY_PORT</key>
        <string>8443</string>
        <key>APNS_KEY_PATH</key>
        <string>/Users/<username>/.apns-key.p8</string>
        <key>APNS_KEY_ID</key>
        <string><apns-key-id></string>
        <key>APNS_TEAM_ID</key>
        <string><apple-team-id></string>
        <key>APNS_PRODUCTION</key>
        <string>0</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/<username>/Library/Logs/ion-relay.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/<username>/Library/Logs/ion-relay.error.log</string>
</dict>
</plist>
