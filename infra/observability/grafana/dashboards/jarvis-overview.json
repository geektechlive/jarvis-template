{
  "uid": "jarvis-overview",
  "title": "Jarvis \u2014 Overview",
  "tags": [
    "jarvis",
    "observability",
    "overview"
  ],
  "timezone": "browser",
  "style": "dark",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Errors (last 1h)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 0,
        "y": 0
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#4ade80",
                "value": null
              },
              {
                "color": "#fbbf24",
                "value": 1
              },
              {
                "color": "#ef4444",
                "value": 25
              }
            ]
          },
          "links": [
            {
              "title": "View errors in Logs Explorer",
              "url": "/d/jarvis-logs/jarvis-logs?var-level=error|critical|fatal&${__url_time_range}",
              "targetBlank": false
            }
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "queryType": "range",
          "legendFormat": "errors",
          "expr": "sum(count_over_time({service=~\".+\"} | level=~\"error|critical|fatal\" [5m]))"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Warnings (last 1h)",
      "datasource": {
