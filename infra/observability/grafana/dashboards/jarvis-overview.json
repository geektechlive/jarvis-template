    {
      "id": 5,
      "type": "stat",
      "title": "Services down / degraded",
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "jarvis-sqlite"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 20,
        "y": 0
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#4ade80",
                "value": null
              },
              {
                "color": "#fbbf24",
                "value": 1
              },
              {
                "color": "#ef4444",
                "value": 2
              }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "jarvis-sqlite"
          },
          "queryType": "table",
          "rawQueryText": "SELECT COUNT(*) AS down FROM (SELECT service, status, MAX(ts) FROM host_health WHERE julianday(ts) > julianday('now','-10 minutes') GROUP BY service) WHERE status != 'ok'",
          "queryText": "SELECT COUNT(*) AS down FROM (SELECT service, status, MAX(ts) FROM host_health WHERE julianday(ts) > julianday('now','-10 minutes') GROUP BY service) WHERE status != 'ok'"
        }
      ]
    },
    {
      "id": 6,
      "type": "state-timeline",
      "title": "Service health over time",
      "description": "Per-service health bands from host_health probes (every ~1m). Green = ok, yellow = warn, red = down. The single best at-a-glance health view.",
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "jarvis-sqlite"
      },
      "gridPos": {
        "h": 10,
        "w": 16,
        "x": 0,
        "y": 5
      },
      "options": {
        "showValue": "never",
        "alignValue": "left",
        "mergeValues": true,
        "rowHeight": 0.9,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          },
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "ok",
                  "color": "#4ade80",
                  "index": 0
                },
                "2": {
                  "text": "warn",
                  "color": "#fbbf24",
                  "index": 1
                },
                "3": {
                  "text": "down",
                  "color": "#ef4444",
                  "index": 2
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#4ade80",
                "value": null
              },
              {
                "color": "#fbbf24",
                "value": 2
              },
              {
                "color": "#ef4444",
                "value": 3
              }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "jarvis-sqlite"
          },
          "queryType": "time series",
          "timeColumns": [
            "time"
          ],
          "rawQueryText": "SELECT CAST(strftime('%s',replace(ts,'Z','')) AS INTEGER) AS time, service, CASE status WHEN 'ok' THEN 1 WHEN 'warn' THEN 2 ELSE 3 END AS state FROM host_health WHERE julianday(ts) >= julianday($__from/1000,'unixepoch') AND julianday(ts) < julianday($__to/1000,'unixepoch') ORDER BY ts",
          "queryText": "SELECT CAST(strftime('%s',replace(ts,'Z','')) AS INTEGER) AS time, service, CASE status WHEN 'ok' THEN 1 WHEN 'warn' THEN 2 ELSE 3 END AS state FROM host_health WHERE julianday(ts) >= julianday($__from/1000,'unixepoch') AND julianday(ts) < julianday($__to/1000,'unixepoch') ORDER BY ts"
        }
      ]
    },
    {
      "id": 7,
      "type": "bargauge",
      "title": "Service status (current)",
      "description": "Latest probe per service. Fallback / companion to the state-timeline for instant current state.",
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "jarvis-sqlite"
      },
      "gridPos": {
        "h": 10,
        "w": 8,
        "x": 16,
        "y": 5
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "lcd",
        "valueMode": "color",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^state$/"
        }
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 3,
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "ok",
                  "color": "#4ade80",
                  "index": 0
                },
                "2": {
                  "text": "warn",
                  "color": "#fbbf24",
                  "index": 1
                },
                "3": {
                  "text": "down",
                  "color": "#ef4444",
                  "index": 2
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#4ade80",
                "value": null
              },
              {
                "color": "#fbbf24",
                "value": 2
              },
              {
                "color": "#ef4444",
                "value": 3
              }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "jarvis-sqlite"
          },
          "queryType": "table",
          "rawQueryText": "SELECT service, CASE status WHEN 'ok' THEN 1 WHEN 'warn' THEN 2 ELSE 3 END AS state FROM (SELECT service, status, MAX(ts) FROM host_health WHERE julianday(ts) > julianday('now','-10 minutes') GROUP BY service) ORDER BY state DESC, service",
          "queryText": "SELECT service, CASE status WHEN 'ok' THEN 1 WHEN 'warn' THEN 2 ELSE 3 END AS state FROM (SELECT service, status, MAX(ts) FROM host_health WHERE julianday(ts) > julianday('now','-10 minutes') GROUP BY service) ORDER BY state DESC, service"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Errors & warnings by service (per 5m)",
      "description": "Errors and warnings overlaid so low error rate is visible alongside warning noise.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 9,
        "w": 16,
        "x": 0,
        "y": 15
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 45,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal"
            }
          },
          "links": [
            {
              "title": "View this service's lines",
              "url": "/d/jarvis-logs/jarvis-logs?var-service=${__field.labels.service}&var-level=error|critical|fatal|warn|warning&${__url_time_range}",
              "targetBlank": false
            }
          ]
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "warn"
            },
            "properties": [
              {
                "id": "custom.drawStyle",
                "value": "line"
              },
              {
                "id": "custom.fillOpacity",
                "value": 10
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#fbbf24"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "err",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "queryType": "range",
          "legendFormat": "err: {{service}}",
          "expr": "sum by (service) (count_over_time({service=~\".+\"} | level=~\"error|critical|fatal\" [5m]))"
        },
        {
          "refId": "warn",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "queryType": "range",
          "legendFormat": "warnings (all)",
          "expr": "sum(count_over_time({service=~\".+\"} | level=~\"warn|warning\" [5m]))"
        }
      ]
    },
    {
      "id": 9,
      "type": "piechart",
      "title": "Cost by model (last 24h)",
      "description": "Correlation: which model is driving spend. Splits on payload_model.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 16,
        "y": 15
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
