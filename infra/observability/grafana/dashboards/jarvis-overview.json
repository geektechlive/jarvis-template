      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "color": {
            "mode": "fixed",
            "fixedColor": "#22d3ee"
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "queryType": "range",
          "legendFormat": "cost",
          "expr": "sum(sum_over_time({service=\"ion-telemetry\", kind=\"run.complete\"} | json | unwrap payload_costUsd [30m]))"
