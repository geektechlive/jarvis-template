        "pieType": "donut",
        "displayLabels": [
          "name",
          "percent"
        ],
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "values": [
            "value"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4,
          "color": {
            "mode": "palette-classic"
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "queryType": "instant",
          "legendFormat": "{{payload_model}}",
          "expr": "sum by (payload_model) (sum_over_time({service=\"ion-telemetry\", kind=\"run.complete\"} | json | unwrap payload_costUsd [24h]))"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Cost trend & cost-per-turn",
      "description": "Correlation: spend over time (bars, left axis) vs efficiency \u2014 cost per turn (line, right axis). Rising cost-per-turn means runs are getting more expensive even if total volume is flat.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "cost"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              },
              {
                "id": "decimals",
                "value": 4
              },
              {
                "id": "custom.drawStyle",
                "value": "bars"
              },
              {
                "id": "custom.fillOpacity",
                "value": 50
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#22d3ee"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "cpt"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              },
              {
                "id": "decimals",
                "value": 4
              },
              {
                "id": "custom.drawStyle",
                "value": "line"
              },
              {
                "id": "custom.lineWidth",
                "value": 2
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#a78bfa"
                }
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "cost",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "queryType": "range",
          "legendFormat": "cost / interval",
          "expr": "sum(sum_over_time({service=\"ion-telemetry\", kind=\"run.complete\"} | json | unwrap payload_costUsd [$__interval]))"
        },
        {
          "refId": "cpt",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "queryType": "range",
          "legendFormat": "cost per turn",
          "expr": "sum(sum_over_time({service=\"ion-telemetry\",kind=\"run.complete\"} | json | unwrap payload_costUsd [$__interval])) / sum(sum_over_time({service=\"ion-telemetry\",kind=\"run.complete\"} | json | unwrap payload_numTurns [$__interval]))"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Latency by phase (perf_metrics)",
      "description": "Per-phase latency from perf_metrics (e.g. recall). Surfaces perf regressions independent of error counts.",
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "jarvis-sqlite"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "points",
            "pointSize": 6,
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "always"
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "jarvis-sqlite"
          },
          "queryType": "time series",
          "timeColumns": [
            "time"
          ],
          "rawQueryText": "SELECT CAST(strftime('%s',replace(created_at,'Z','')) AS INTEGER) AS time, phase, latency_ms FROM perf_metrics WHERE julianday(created_at) >= julianday($__from/1000,'unixepoch') AND julianday(created_at) < julianday($__to/1000,'unixepoch') ORDER BY created_at",
          "queryText": "SELECT CAST(strftime('%s',replace(created_at,'Z','')) AS INTEGER) AS time, phase, latency_ms FROM perf_metrics WHERE julianday(created_at) >= julianday($__from/1000,'unixepoch') AND julianday(created_at) < julianday($__to/1000,'unixepoch') ORDER BY created_at"
        }
      ]
    },
